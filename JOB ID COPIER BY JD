-- ============================================
-- COPY FUNCTION
-- ============================================
local function copyJobId()
    local jobId = game.JobId
    local success = false
    
    -- Try different clipboard methods
    if setclipboard then
        pcall(function()
            setclipboard(jobId)
            success = true
        end)
    end
    
    if not success and toclipboard then
        pcall(function()
            toclipboard(jobId)
            success = true
        end)
    end
    
    if not success then
        pcall(function()
            if syn and syn.set_clipboard then
                syn.set_clipboard(jobId)
                success = true
            end
        end)
    end
    
    if not success then
        pcall(function()
            if game:GetService("GuiService"):GetClipboard() then
                game:GetService("GuiService"):SetClipboard(jobId)
                success = true
            end
        end)
    end
    
    -- Also print to console
    print("Job ID: " .. jobId)
    
    -- Build full teleport script too
    local placeId = game.PlaceId
    local teleportScript = string.format(
        'game:GetService("TeleportService"):TeleportToPlaceInstance(%s,"%s",game.Players.LocalPlayer)',
        placeId,
        jobId
    )
    
    -- Also copy the full script to clipboard if possible
    if success then
        -- Update button appearance
        CopyButton.Text = "COPIED!"
        CopyButton.BackgroundColor3 = Color3.fromRGB(30, 80, 50)
        StatusLabel.Text = "Job ID copied! Place ID: " .. placeId
        StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        
        -- Show notification
        if syn and syn.notify then
            syn.notify("Job ID copied to clipboard!", 3)
        end
        
        -- Print full teleport script in console
        print("Full Teleport Script:")
        print(teleportScript)
        
        -- Reset button after 2 seconds
        task.delay(2, function()
            CopyButton.Text = "COPY JOB ID"
            CopyButton.BackgroundColor3 = Color3.fromRGB(30, 50, 80)
            StatusLabel.Text = "Click button to copy Job ID"
            StatusLabel.TextColor3 = Color3.fromRGB(150, 150, 170)
        end)
    else
        -- If copy failed, show error
        CopyButton.Text = "FAILED"
        CopyButton.BackgroundColor3 = Color3.fromRGB(80, 30, 30)
        StatusLabel.Text = "Failed to copy! Check console for Job ID"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        print("Could not copy to clipboard. Job ID: " .. jobId)
        
        task.delay(2, function()
            CopyButton.Text = "COPY JOB ID"
            CopyButton.BackgroundColor3 = Color3.fromRGB(30, 50, 80)
            StatusLabel.Text = "Click button to copy Job ID"
            StatusLabel.TextColor3 = Color3.fromRGB(150, 150, 170)
        end)
    end
end

